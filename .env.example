# Copy to .env (git-ignored); Quarkus reads it at start-up.
# Ollama servers to try, in order. Put a Bonjour name first if the machine's IP changes.
CASHBOOK_LLM_OLLAMA_URLS=http://my-mac.local:11434,http://192.168.1.10:11434
# Use the LLM by default (otherwise pass --llm ollama per run). Rules only: none.
CASHBOOK_LLM_PROVIDER=none
# CASHBOOK_LLM_OLLAMA_MODEL=qwen3:30b
