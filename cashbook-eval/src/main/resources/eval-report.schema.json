{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ksktech/cashbook-agent/eval-report.schema.json",
  "title": "Cashbook evaluation report",
  "type": "object",
  "required": ["generated", "golden", "period", "modes"],
  "properties": {
    "generated": {"type": "string", "format": "date"},
    "golden": {"type": "string"},
    "period": {"type": "string", "pattern": "^\\d{4}-\\d{2}:\\d{4}-\\d{2}$"},
    "modes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mode"}}
  },
  "$defs": {
    "money": {"type": "number"},
    "line": {
      "type": "object",
      "required": ["month", "code", "amount", "gstCollected", "gstClaimed", "ruleDecided"],
      "properties": {
        "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
        "date": {"type": ["string", "null"], "format": "date"},
        "code": {"type": "string"},
        "detail": {"type": "string"},
        "amount": {"$ref": "#/$defs/money"},
        "gstCollected": {"$ref": "#/$defs/money"},
        "gstClaimed": {"$ref": "#/$defs/money"},
        "source": {"type": "string"},
        "ruleDecided": {"type": "boolean"}
      }
    },
    "pair": {
      "type": "object",
      "required": ["golden", "actual"],
      "properties": {"golden": {"$ref": "#/$defs/line"}, "actual": {"$ref": "#/$defs/line"}}
    },
    "codeScore": {
      "type": "object",
      "required": ["code", "goldenLines", "actualLines", "matched", "precision", "recall", "goldenAmount", "actualAmount", "difference"],
      "properties": {
        "code": {"type": "string"},
        "goldenLines": {"type": "integer", "minimum": 0},
        "actualLines": {"type": "integer", "minimum": 0},
        "matched": {"type": "integer", "minimum": 0},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "goldenAmount": {"$ref": "#/$defs/money"},
        "actualAmount": {"$ref": "#/$defs/money"},
        "difference": {"$ref": "#/$defs/money"}
      }
    },
    "score": {
      "type": "object",
      "required": ["goldenLines", "actualLines", "matched", "wrongCode", "missing", "extra", "accuracy",
        "ruleDecidedLines", "ruleDecidedCorrect", "goldenGstCollected", "actualGstCollected", "gstCollectedDiff",
        "goldenGstClaimed", "actualGstClaimed", "gstClaimedDiff", "gstWithinTolerance", "codes"],
      "properties": {
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "gstWithinTolerance": {"type": "boolean"},
        "codes": {"type": "array", "items": {"$ref": "#/$defs/codeScore"}}
      }
    },
    "stats": {
      "type": "object",
      "required": ["reviewItems", "pendingLines", "llmCalls", "llmInputTokens", "llmOutputTokens", "llmMillis",
        "costNzd", "runMillis", "statements", "statementsReconciled", "reconcileProblems", "exportFailures"],
      "properties": {
        "costNzd": {"anyOf": [{"type": "null"}, {"const": 0}]},
        "reconcileProblems": {"type": "array", "items": {"type": "string"}},
        "exportFailures": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    },
    "mode": {
      "type": "object",
      "required": ["mode", "classifier", "notRun", "score", "stats", "matching"],
      "properties": {
        "mode": {"type": "string"},
        "classifier": {"type": "string"},
        "notRun": {"type": ["string", "null"]},
        "score": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/score"}]},
        "stats": {"$ref": "#/$defs/stats"},
        "matching": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["matched", "wrongCode", "missing", "extra"],
              "properties": {
                "matched": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
                "wrongCode": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
                "missing": {"type": "array", "items": {"$ref": "#/$defs/line"}},
                "extra": {"type": "array", "items": {"$ref": "#/$defs/line"}}
              }
            }
          ]
        }
      }
    }
  }
}
